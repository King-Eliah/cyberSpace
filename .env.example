# ─── Google Gemini ────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com → "Get API key"
GOOGLE_AI_API_KEY=

# Optional overrides. gemini-2.5-flash is retired for new keys.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=45000

# ─── Database (Supabase → Connect → ORMs) ─────────────────────────────────────
# DATABASE_URL = Transaction pooler (port 6543). Used at runtime.
# DIRECT_URL   = Session pooler or direct (port 5432). Used for migrations only.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

# Optional: connections per serverless instance (default 5)
# PG_POOL_MAX=5
# Optional: set to "true" to enforce TLS certificate verification
# DB_SSL_STRICT=false

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000 — on Vercel: your production domain (https://...)
NEXTAUTH_URL=http://localhost:3000

# ─── Upstash Redis — rate limiting ────────────────────────────────────────────
# NOTE: rate limiting is currently NOT wired up (see src/lib/rate-limit.ts).
# Setting these alone does not enable it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
